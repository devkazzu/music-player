{
  "name": "hiro-segawa-music-player",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HIRO SEGAWA \u2014 an anime cinematic music player with a real audio engine, local library, and offline PWA support.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/make-404.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:audio": "node scripts/generate-audio.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "build:pages": "VITE_BASE=/music-player/ npm run build",
    "build:android": "VITE_DISABLE_SW=1 npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
